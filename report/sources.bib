@article{ABREGO2008261,
title = {The maximum number of halving lines and the rectilinear crossing number of Kn for n⩽27},
journal = {Electronic Notes in Discrete Mathematics},
volume = {30},
pages = {261-266},
year = {2008},
note = {The IV Latin-American Algorithms, Graphs, and Optimization Symposium},
issn = {1571-0653},
doi = {https://doi.org/10.1016/j.endm.2008.01.045},
url = {https://www.sciencedirect.com/science/article/pii/S1571065308000462},
author = {Bernardo M. Ábrego and Silvia Fernández–Merchant and Jesús Leaños and Gelasio Salazar},
keywords = {Halving lines, rectilinear crossing number, complete graphs},
abstract = {For n⩽27 we present exact values for the maximum number h(n) of halving lines and h˜(n) of halving pseudolines, determined by n points in the plane. For this range of values of n we also present exact values of the rectilinear cr¯(Kn) and the pseudolinear cr˜(Kn) crossing numbers of the complete graph Kn. h˜(n) and cr˜(Kn) are new for n∈{14,16,18,20,22,23,24,25,26,27}, h(n) is new for n∈{16,18,20,22,23,24,25,26,27}, and cr¯(Kn) is new for n∈{20,22,23,24,25,26,27}.}
}

